<?xml version = "1.0" encoding = "UTF-8" standalone = "yes" ?>
<template xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="settlement.xsd"
    name="Mining Outpost" default-population="8" description="Base for Mining Outpost for Mars Society"
    sponsor="MS" objective="MANUFACTURING_DEPOT">
    
    <building id="00" type="Outpost Hub" xloc="0.0" yloc="0.0"
        facing="0.0">
        <connection-list>
            <connection id="1" xloc="-5.0" yloc="2.5" />
            <connection id="3" xloc="-5.0" yloc="-2.5" />
            <connection id="5" xloc="5.0" yloc="2.5" />
            <connection id="9" xloc="5.0" yloc="-2.5" />
            <connection id="T0" xloc="0.0" yloc="5.0" />
            <connection id="IG" hatch-facing="south" />
        </connection-list>
    </building>
    <building id="T0" type="Tunnel" length="4.0" xloc="0.0"
        yloc="7.0" facing="0.0">
        <connection-list>
            <connection id="00" xloc="0.0" yloc="-2.0" />
            <connection id="LDG" xloc="0.0" yloc="2.0" />
            <connection id="EVA" hatch-facing="west" />
        </connection-list>
    </building>
    <building id="LDG" type="Loading Dock Garage" xloc="0.0"
        yloc="18.0" facing="0.0">
        <connection-list>
            <connection id="T0" xloc="0.0" yloc="-9.0" />
        </connection-list>
    </building>
    <building id="IG" type="Inground Greenhouse" xloc="0.0" yloc="-7.5" facing="90.0">
        <connection-list>
            <connection id="00" hatch-facing="north" />
        </connection-list>
    </building>
    
    <!-- EVA Airlock is attached to the Tunnel that connects the Outpost Hub and Loading Dock Garage -->
    <building id="EVA" type="EVA Airlock" xloc="4.5" yloc="7.0" facing="0.0">
        <connection-list>
            <connection id="T0" hatch-facing="east" />
        </connection-list>
    </building>
    
    <!-- East side -->
   <building id="1" type="Tunnel" length="2.0" xloc="-6.0"
        yloc="2.5" facing="270.0">
        <connection-list>
            <connection id="00" xloc="0.0" yloc="1.0" />
            <connection id="2" xloc="0.0" yloc="-1.0" />
        </connection-list>
    </building>
    <building id="2" type="Bunkhouse" xloc="-9.5" yloc="2.5"
        facing="270.0">
        <connection-list>
            <connection id="1" xloc="0.0" yloc="2.5" />
        </connection-list>
    </building>
    <building id="3" type="Tunnel" length="2.0" xloc="-6.0"
        yloc="-2.5" facing="270.0">
        <connection-list>
            <connection id="00" xloc="0.0" yloc="1.0" />
            <connection id="4" xloc="0.0" yloc="-1.0" />
        </connection-list>
    </building>
    <building id="4" type="Bunkhouse" xloc="-9.5" yloc="-2.5"
        facing="270.0">
        <connection-list>
            <connection id="3" xloc="0.0" yloc="2.5" />
        </connection-list>
    </building>
    <!-- End of East side -->
    
    <!-- West side -->
    <building id="5" type="Tunnel" length="2.0" xloc="6.0"
        yloc="2.5" facing="90.0">
        <connection-list>
            <connection id="00" hatch-facing="east" />
            <connection id="6" hatch-facing="west" />
        </connection-list>
    </building>
    <building id="6" type="Dining Hall" xloc="9.5" yloc="2.5"
        facing="0.0">
        <connection-list>
            <connection id="5" hatch-facing="east" />
            <connection id="7" hatch-facing="west" />
            <connection id="10" hatch-facing="south"/>
        </connection-list>
    </building>
    <building id="7" type="Tunnel" length="2.0" xloc="13.0"
        yloc="2.5" facing="90.0">
        <connection-list>
            <connection id="6" xloc="0.0" yloc="1.0" />
            <connection id="8" xloc="0.0" yloc="-1.0" />
        </connection-list>
    </building>
    <building id="8" type="Manufacturing Shed" xloc="16.5"
        yloc="2.5" facing="90.0">
        <connection-list>
            <connection id="7" xloc="0.0" yloc="2.5" />
            <connection id="12" xloc="-2.5" yloc="0.0" />
        </connection-list>
    </building>
    <building id="9" type="Tunnel" length="2.0" xloc="6.0"
        yloc="-2.5" facing="90.0">
        <connection-list>
            <connection id="00" xloc="0.0" yloc="1.0" />
            <connection id="10" xloc="0.0" yloc="-1.0" />
        </connection-list>
    </building>
    <building id="10" type="Mining Lab" xloc="9.5" yloc="-2.5"
        facing="90.0">
        <connection-list>
            <connection id="9" xloc="0.0" yloc="2.5" />
            <connection id="11" xloc="0.0" yloc="-2.5" />
            <connection id="6" xloc="2.5" yloc="0.0" />
        </connection-list>
    </building>
    <building id="11" type="Tunnel" length="2.0" xloc="13.0"
        yloc="-2.5" facing="90.0">
        <connection-list>
            <connection id="10" xloc="0.0" yloc="1.0" />
            <connection id="12" xloc="0.0" yloc="-1.0" />
        </connection-list>
    </building>
    <building id="12" type="Storage Shed" xloc="16.5"
        yloc="-2.5" facing="90.0">
        <connection-list>
            <connection id="11" xloc="0.0" yloc="2.5" />
            <connection id="13" xloc="0.0" yloc="-2.5" />
            <connection id="8" xloc="2.5" yloc="0.0" />
        </connection-list>
    </building>
    <building id="13" type="Tunnel" length="2.0" xloc="20.0"
        yloc="-2.5" facing="90.0">
        <connection-list>
            <connection id="12" xloc="0.0" yloc="1.0" />
            <connection id="14" xloc="0.0" yloc="-1.0" />
        </connection-list>
    </building>
    <building id="14" type="Storage Shed" xloc="23.5"
        yloc="-2.5" facing="90.0">
        <connection-list>
            <connection id="13" xloc="0.0" yloc="2.5" />
        </connection-list>
    </building>
    <!-- End of East side -->
    
    <!-- Building Packages -->
    <building-package name="Storage Set 1"/>   
   	<building-package name="ERV Set 1"/>
 	<building-package name="Air Set 1 - 1x2"/>
    <building-package name="Sabatier Set 1 - 1x2"/>
	<building-package name="Syngas Set 1 - 1x1"/>
 	<building-package name="Wind Set 1 - 1x9"/>   
	<building-package name="Solar Set 1 - 1x9"/>
	<building-package name="Solar Thermal Set 1 - 1x9"/>
 	<building-package name="Brine Water Well Set 1 - 1x1"/>
 	
    <initial-supplies>

 	<vehicle type="Cargo Rover" number="1" />
    <vehicle type="Explorer Rover" number="2" />
    <vehicle type="Light Utility Vehicle" number="4" />
    <vehicle type="Delivery Drone" number="2" />

    <robot type="MakerBot-Standard" number="1"/>
    <robot type="MedicBot-Standard" number="1"/>
    <robot type="RepairBot-Standard" number="1"/>
    <robot type="DeliveryBot-Standard" number="1"/>
    
	<!-- Equipment -->
    <equipment type="EVA Suit" number="8" />
   	<equipment type="Data Recorder" number="4" />
   	    
    <!-- Containers-->
	<equipment type="barrel" number="40" />
	<equipment type="bag" number="40" />
	<equipment type="gas canister" number="40" />		
	<equipment type="large bag" number="40" />
	<equipment type="specimen box" number="40" />
    <equipment type="thermal bottle" number="8" />	
 	<equipment type="wheelbarrow" number="12" />
    
    <!-- Life Support Resources -->
	<resource type="food" amount="2880" />
	<resource type="water" amount="8400" />
	<resource type="oxygen" amount="7200" />
	<resource type="hydrogen" amount="7200" />
	<resource type="methane" amount="7200" />
	<resource type="methanol" amount="7200" />
	
    <part-package name="Standard Part Package 1" number="1" />
    <part-package name="Instrument Package 1" number="1" />

    </initial-supplies>

  
    <resupply>
       	<resupply-mission name="Quarterly Delivery" manifest-name="Standard Resupply 1">
            <schedule eventTime="400" frequency="150" /> 
        </resupply-mission>
    </resupply> 
</template>